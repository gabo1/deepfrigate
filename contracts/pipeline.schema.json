{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepfrigate.local/contracts/pipeline.schema.json",
  "title": "DeepFrigate declarative pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "pipeline"
  ],
  "properties": {
    "api_version": {
      "const": "deepfrigate/v1"
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "cameras",
        "detection",
        "tracker"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "cameras": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source_env"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              },
              "source_env": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "gpu": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "rtsp_reconnect_interval": {
                "type": "integer",
                "minimum": 0,
                "default": 10,
                "description": "Segundos sin datos antes de forzar una reconexion RTSP. 0 desactiva. Sin esto un EOS de la fuente es definitivo: DeepStream la suelta y el pipeline sigue sin avisar."
              },
              "rtsp_reconnect_attempts": {
                "type": "integer",
                "default": -1,
                "description": "-1 = reintentar sin limite."
              }
            }
          }
        },
        "detection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "version",
            "config_path"
          ],
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "config_path": {
              "type": "string",
              "pattern": "^/.*"
            },
            "gpu": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "config_path",
            "width",
            "height"
          ],
          "properties": {
            "type": {
              "const": "nvtracker"
            },
            "config_path": {
              "type": "string",
              "pattern": "^/.*"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "gpu": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        },
        "frame_export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "labels"
          ],
          "properties": {
            "labels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "enrichments": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "model",
              "family",
              "labels"
            ],
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1
              },
              "family": {
                "enum": [
                  "pp-shitu",
                  "plate-recognition",
                  "pulc-person",
                  "pulc-vehicle"
                ]
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "camera"
            ],
            "properties": {
              "type": {
                "enum": [
                  "zone",
                  "stationary",
                  "specific_plate",
                  "visual_match"
                ]
              },
              "camera": {
                "type": "string",
                "minLength": 1
              },
              "zone": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "const": "zone"
                    }
                  }
                },
                "then": {
                  "required": [
                    "zone"
                  ]
                }
              }
            ]
          }
        }
      }
    }
  }
}
