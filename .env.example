# Images are deliberately pinned. Do not replace them with latest.
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.01-py3
DEEPSTREAM_IMAGE=nvcr.io/nvidia/deepstream:9.0-triton-multiarch
FRIGATE_IMAGE=ghcr.io/blakeblackshear/frigate:0.18.0-beta3-tensorrt

# Video inputs
RTSP_TIENDA=rtsp://100.83.231.97:8554/tienda
RTSP_TRAFICO=rtsp://100.83.231.97:8554/trafico
RTSP_USER=rtsp://100.83.231.97:8554/user
FRAME_EXPORT_LABELS=person,car
FRAME_TTL_SECONDS=15
FRAME_REFRESH_SECONDS=5
FRAME_MIN_EXPORT_SECONDS=1
FRAME_CONFIDENCE_IMPROVEMENT=0.05
FRAME_CROP_PADDING=0.1
FRAME_STALL_RESTART_SECONDS=120
FRAME_REF_WORKERS=4
TRITON_MODEL=vehicle-embedding
QDRANT_COLLECTION=vehicle_embeddings
EMBEDDING_LABELS=person,car
EMBEDDING_MAX_PER_TRACK=3
EMBEDDING_MIN_CROP_WIDTH=48
EMBEDDING_MIN_CROP_HEIGHT=32
DS_SNAPSHOT_DIR=/opt/ds-snapshots
DS_SNAPSHOT_RETENTION_HOURS=24
EVENT_QUEUE_SIZE=1024
FRIGATE_BRIDGE_QUEUE_SIZE=8192
FRIGATE_BRIDGE_UPDATE_SECONDS=1
FRIGATE_REVIEW_BRIDGE=true
FRIGATE_REVIEW_LABELS=person,car
FRIGATE_API_TIMEOUT_SECONDS=5
# Lab smoke (:3005). Export all four together when recreating
# event-engine against frigate-pgvector-smoke. Omit them to target
# the product NVR. See HANDOFF.md (2–3 sep 2026).
# FRIGATE_API_URL=http://frigate-pgvector-smoke:5000/api
# FRIGATE_DB_PATH=
# FRIGATE_EVENT_STORE_URL=postgresql://frigate_pgvector:frigate_pgvector_smoke@pgvector-smoke-db:5432/frigate_pgvector_smoke
# FRIGATE_BRIDGE_MEDIA_VOLUME=frigate-pg_pgvector-smoke-media
ATTRIBUTE_LABELS=person,car
ATTRIBUTE_TRITON_MODEL=person-attribute
VEHICLE_ATTRIBUTE_TRITON_MODEL=vehicle-attribute
ATTRIBUTE_MAX_PER_TRACK=2
ATTRIBUTE_MIN_CROP_WIDTH=64
ATTRIBUTE_MIN_CROP_HEIGHT=96
VEHICLE_ATTRIBUTE_MIN_CROP_WIDTH=80
VEHICLE_ATTRIBUTE_MIN_CROP_HEIGHT=48
TRITON_REQUIRED_MODELS=object-detector,vehicle-embedding,person-attribute,vehicle-attribute
MODEL_MANAGEMENT_ALLOW_UNLOAD=false

# Development storage credentials. Replace before any non-development use.
POSTGRES_DB=deepfrigate
POSTGRES_USER=deepfrigate
POSTGRES_PASSWORD=change-me-before-production
# Deprecated: recording-sync + MinIO. Do not deploy. Kept for the
# compose profile `deprecated` only.
SITE_ID=local
S3_ENDPOINT=http://minio:9000
S3_BUCKET=deepfrigate
S3_REGION=us-east-1
S3_ACCESS_KEY=deepfrigate
S3_SECRET_KEY=change-me-before-production
S3_API_PORT=9000
S3_CONSOLE_PORT=9001
RECORDING_POLL_SECONDS=10
RECORDING_BATCH_SIZE=20

# Host ports
WEB_PORT=3002
WEB_DEV_PORT=5173
PLATFORM_API_PORT=8082
FRAME_STORE_PORT=8083
TRITON_HTTP_PORT=8010
TRITON_GRPC_PORT=8011
TRITON_METRICS_PORT=8012
MQTT_PORT=1883
POSTGRES_PORT=5433
QDRANT_HTTP_PORT=6343
QDRANT_GRPC_PORT=6344
GO2RTC_API_PORT=1984
FRIGATE_RTSP_PORT=8556
GO2RTC_WEBRTC_PORT=8555
