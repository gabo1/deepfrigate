          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "frigate-smoke-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT data->'person_attributes'->'lower'->>'value' AS \"prenda\",\n       count(*) AS \"events\"\n  FROM event\n WHERE $__unixEpochFilter(start_time)\n   AND data->'person_attributes'->'lower'->>'value' IS NOT NULL\n GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
