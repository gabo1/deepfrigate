                      "color": "red",
                      "value": 7
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          }
        ]
      },
      "description": "El vídeo es el mismo en cada vuelta de 299,1 s, así que la verdad no cambia: **toda esta desviación es ruido del clasificador**. Léelo como el margen de error de los paneles de arriba — si la cuota de un valor se mueve menos que su ruido, no ha pasado nada. Medido: `bag` ±8,8 pp y `gender` ±6,1 pp, que es mucho para un binario sobre entrada idéntica."
    }
