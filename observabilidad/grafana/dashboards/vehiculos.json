    {
      "type": "barchart",
      "title": "Tipo de carrocería",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "frigate-smoke-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "frigate-smoke-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE\n         WHEN v LIKE 'sedan%%'  THEN 'sedan'\n         WHEN v LIKE 'suv%%'    THEN 'suv'\n         WHEN v LIKE 'truck%%' OR v = 'pickup' THEN 'pickup/truck'\n         WHEN v LIKE 'van%%'   OR v = 'mpv'    THEN 'van/mpv'\n         WHEN v LIKE 'bus%%'   OR v LIKE 'tractor%%' THEN 'bus/trailer'\n         ELSE v END AS \"tipo\", count(*) AS \"coches\"\n  FROM event, LATERAL (SELECT data->'vehicle_attributes'->'body_type'->>'value') t(v)\n WHERE label = 'car' AND v IS NOT NULL\n   AND $__unixEpochFilter(start_time)\n   AND camera = '$camera'\n GROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "barWidth": 0.75,
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "description": "Normalizado: PULC escribe `sedan` y OpenALPR `sedan-standard` / `sedan-compact` para lo mismo. Sin el CASE salen dos barras por tipo."
    },
