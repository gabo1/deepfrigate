          "rawSql": "SELECT date_trunc('hour', to_timestamp(start_time)) AS time,\n       count(*) FILTER (WHERE data ? 'recognized_license_plate')\n         AS \"placas\",\n       count(*) AS \"coches\"\n  FROM event\n WHERE label = 'car' AND $__unixEpochFilter(start_time)\n   AND camera = '$camera'\n GROUP BY 1 ORDER BY 1"
