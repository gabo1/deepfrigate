            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never",
            "axisBorderShow": false
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Un Event de Frigate por objeto seguido en TODA la cámara, no solo dentro de `area_cajas`: por eso hay muchos más Events que gente en la zona de cajas. Se aproximan a personas distintas (solo el 0,1 % parecen reanudaciones de un track perdido), pero quien pasa dos veces cuenta dos."
    },
    {
      "type": "table",
      "title": "Events por zona",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "frigate-smoke-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "frigate-smoke-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT jsonb_array_elements_text(zones) AS \"zona\",\n       count(*) AS \"events\",\n       round(avg(end_time - start_time)::numeric, 1) AS \"duración media (s)\"\n  FROM event\n WHERE $__unixEpochFilter(start_time)\n   AND camera = '$camera'\n GROUP BY 1\n ORDER BY 2 DESC"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto"
          }
        },
        "overrides": []
      },
      "description": "“Pasó por la zona”, no aforo. El aforo instantáneo es `sv_zona_presentes`, arriba. Tabla y no gráfico de barras porque hoy solo hay una zona configurada."
    },
    {
      "type": "stat",
      "title": "Events en el rango",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "frigate-smoke-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "frigate-smoke-pg"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE start_time >= $__unixEpochFrom())\n         AS \"Events\",\n       count(*) FILTER (WHERE start_time < $__unixEpochFrom())\n         AS \"Periodo previo\"\n  FROM event\n WHERE camera = '$camera'\n   AND start_time >= $__unixEpochFrom()\n                   - ($__unixEpochTo() - $__unixEpochFrom())\n   AND start_time <= $__unixEpochTo()"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
