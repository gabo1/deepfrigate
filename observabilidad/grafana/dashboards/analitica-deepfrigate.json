        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "frigate-smoke-pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(ts, '5m'),\n       label AS metric,\n       count(*) AS value\n  FROM (SELECT to_timestamp(start_time) AS ts, label\n          FROM event\n         WHERE $__unixEpochFilter(start_time)\n           AND camera = '$camera') e\n GROUP BY 1, 2\n ORDER BY 1"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "showLegend": true,
          "displayMode": "list",
