    {
      "type": "timeseries",
      "title": "Events por 5 min",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "frigate-smoke-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
